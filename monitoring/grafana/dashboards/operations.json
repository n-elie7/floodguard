{
  "uid":"floodguard-operations",
  "title":"FloodGuard operations",
  "schemaVersion":41,
  "version":1,
  "refresh":"30s",
  "time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"timeseries","title":"API requests / second","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"floodguard-prometheus"},"targets":[{"expr":"sum by (uri,status) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[5m]))","legendFormat":"{{uri}} {{status}}","refId":"A"}]},
    {"id":2,"type":"timeseries","title":"Mean API latency","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"floodguard-prometheus"},"targets":[{"expr":"sum(rate(http_server_requests_seconds_sum{uri=~\"/api/.*\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[5m])), 0.001)","legendFormat":"seconds","refId":"A"}]},
    {"id":3,"type":"timeseries","title":"Scoring duration","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"floodguard-prometheus"},"targets":[{"expr":"rate(floodguard_scoring_duration_seconds_sum[5m]) / clamp_min(rate(floodguard_scoring_duration_seconds_count[5m]), 0.001)","legendFormat":"mean seconds / sector","refId":"A"}]},
    {"id":4,"type":"timeseries","title":"Ingestion failures and SMS submissions","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"floodguard-prometheus"},"targets":[{"expr":"increase(floodguard_ingestion_failures_total[1h])","legendFormat":"ingestion failures","refId":"A"},{"expr":"sum(increase(floodguard_sms_delivery_total{status=\"submitted\"}[1h]))","legendFormat":"SMS submitted","refId":"B"}]}
  ]
}
